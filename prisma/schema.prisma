generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id              String           @id @default(cuid())
  email           String           @unique
  name            String
  password        String
  phone           String?
  avatar          String?
  role            String           @default("user")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  bookings        Booking[]
  reviews         Review[]
  wishlist        Wishlist[]
  packageReviews  PackageReview[]
  packageBookings PackageBooking[]
}

model Destination {
  id          String   @id @default(cuid())
  name        String
  tagline     String
  description String
  state       String
  category    String
  price       Int
  rating      Float    @default(0)
  reviewCount Int      @default(0)
  image       String
  badge       String?
  badgeColor  String?
  tags        String
  featured    Boolean  @default(false)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  bookings    Booking[]
  reviews     Review[]
  wishlist    Wishlist[]
}

model Booking {
  id            String      @id @default(cuid())
  userId        String
  destinationId String
  user          User        @relation(fields: [userId], references: [id])
  destination   Destination @relation(fields: [destinationId], references: [id])
  checkIn       DateTime
  checkOut      DateTime
  guests        Int         @default(1)
  totalPrice    Int
  status        String      @default("pending")
  paymentStatus String      @default("pending")
  phone         String?
  specialReqs   String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model Review {
  id            String      @id @default(cuid())
  userId        String
  destinationId String
  user          User        @relation(fields: [userId], references: [id])
  destination   Destination @relation(fields: [destinationId], references: [id])
  rating        Int
  comment       String
  createdAt     DateTime    @default(now())
}

model Wishlist {
  id            String      @id @default(cuid())
  userId        String
  destinationId String
  user          User        @relation(fields: [userId], references: [id])
  destination   Destination @relation(fields: [destinationId], references: [id])
  createdAt     DateTime    @default(now())
}

model Package {
  id                 String          @id @default(cuid())
  name               String
  slug               String          @unique
  tagline            String
  subtitle           String
  description        String
  price              Int
  image              String
  images             String          @default("[]")
  category           String          @default("rafting")
  distance           String          @default("")
  duration           String          @default("")
  rapidsLevel        String          @default("")
  rapidsDescription  String          @default("")
  targetDemo         String          @default("")
  timings            String          @default("")
  highlights         String          @default("[]")
  inclusions         String          @default("[]")
  exclusions         String          @default("[]")
  eligibility        String          @default("")
  location           String          @default("")
  cancellationPolicy String          @default("")
  faqs               String          @default("[]")
  badge              String?
  badgeColor         String          @default("bg-brand-orange")
  gradient           String          @default("from-brand-orange/80 to-amber-600/80")
  featured           Boolean         @default(false)
  active             Boolean         @default(true)
  rating             Float           @default(0)
  reviewCount        Int             @default(0)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  reviews            PackageReview[]
  bookings           PackageBooking[]
}

model PackageReview {
  id        String   @id @default(cuid())
  userId    String
  packageId String
  user      User     @relation(fields: [userId], references: [id])
  package   Package  @relation(fields: [packageId], references: [id])
  rating    Int
  comment   String
  createdAt DateTime @default(now())
}

model PackageBooking {
  id              String   @id @default(cuid())
  userId          String
  packageId       String
  user            User     @relation(fields: [userId], references: [id])
  package         Package  @relation(fields: [packageId], references: [id])
  fullName        String
  mobile          String
  numberOfPeople  Int      @default(1)
  preferredDate   DateTime
  preferredTime   String?
  additionalNotes String?
  totalPrice      Int
  status          String   @default("pending")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
