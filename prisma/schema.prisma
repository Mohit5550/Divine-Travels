generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./custom.db"
}

model User {
  id               String           @id @default(cuid())
  email            String           @unique
  name             String
  password         String
  phone            String?
  avatar           String?
  role             String           @default("user")
  preferences      String           @default("{}")
  resetToken       String?
  resetCode        String?
  resetTokenExpiry DateTime?
  upiId            String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  bookings         Booking[]
  reviews          Review[]
  wishlist         Wishlist[]
  packageReviews   PackageReview[]
  packageBookings  PackageBooking[]
  packageWishlist  PackageWishlist[]
  notifications    Notification[]
  paymentRequests  PaymentRequest[]
  payments         Payment[]
  paymentReceipts  PaymentReceipt[]
  tourBookings     TourBooking[]
  refunds          Refund[]
  pushSubscriptions PushSubscription[]
}

model Destination {
  id          String   @id @default(cuid())
  name        String
  slug        String?  @unique
  tagline     String
  description String
  state       String
  category    String
  price       Int
  rating      Float    @default(0)
  reviewCount Int      @default(0)
  image       String
  badge       String?
  badgeColor  String?
  featured    Boolean  @default(false)
  active      Boolean  @default(true)
  tags        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  bookings    Booking[]
  reviews     Review[]
  wishlist    Wishlist[]
}

model Booking {
  id            String      @id @default(cuid())
  userId        String
  destinationId String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  checkIn       DateTime
  checkOut      DateTime
  guests        Int         @default(1)
  totalPrice    Int
  status            String      @default("pending")
  paymentStatus String      @default("pending")
  paymentAmount Int?
  phone         String?
  specialReqs   String?
  negotiatedPrice Int?
  priceLocked   Boolean      @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model Review {
  id            String      @id @default(cuid())
  userId        String
  destinationId String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  rating        Int
  comment       String
  approved      Boolean     @default(true)
  createdAt     DateTime    @default(now())
}

model Wishlist {
  id            String      @id @default(cuid())
  userId        String
  destinationId String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())
}

model Package {
  id                 String          @id @default(cuid())
  name               String
  slug               String          @unique
  tagline            String
  subtitle           String
  description        String
  price              Int
  originalPrice      Int?
  image              String
  images             String          @default("[]")
  category           String          @default("rafting")
  distance           String          @default("")
  duration           String          @default("")
  rapidsLevel        String          @default("")
  rapidsDescription  String          @default("")
  targetDemo         String          @default("")
  timings            String          @default("")
  highlights         String          @default("[]")
  inclusions         String          @default("[]")
  exclusions         String          @default("[]")
  eligibility        String          @default("")
  location           String          @default("")
  pickupLocationUrl  String          @default("")
  locationUrls       String          @default("[]")
  cancellationPolicy String          @default("")
  faqs               String          @default("[]")
  badge              String?
  badgeColor         String          @default("bg-brand-orange")
  gradient           String          @default("from-brand-orange/80 to-amber-600/80")
  featured           Boolean         @default(false)
  active             Boolean         @default(true)
  rating             Float           @default(0)
  reviewCount        Int             @default(0)
  // Trekking-spec fields
  routeLength        String          @default("")
  maxAltitude        String          @default("")
  baseCamp           String          @default("")
  pickupPoint        String          @default("")
  suitableFor        String          @default("")
  experience         String          @default("")
  fitness            String          @default("")
  bestSeason         String          @default("")
  gstRate            Int             @default(5)
  itinerary          String          @default("[]")
  thingsToCarry      String          @default("[]")
  howToReach         String          @default("[]")
  importantInfo      String          @default("")
  fixedDepartures    String          @default("[]")
  // Hotel-specific fields
  propertyType       String          @default("")
  amenities          String          @default("[]")
  roomTypes          String          @default("[]")
  mealPlans          String          @default("[]")
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  reviews            PackageReview[]
  bookings           PackageBooking[]
  wishlist           PackageWishlist[]
}

model PackageReview {
  id        String   @id @default(cuid())
  userId    String
  packageId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  package   Package  @relation(fields: [packageId], references: [id], onDelete: Cascade)
  rating    Int
  comment   String
  approved  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model PackageBooking {
  id                String     @id @default(cuid())
  userId            String
  packageId         String
  user              User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  package           Package    @relation(fields: [packageId], references: [id], onDelete: Cascade)
  fullName          String
  mobile            String
  numberOfPeople    Int        @default(1)
  preferredDate     DateTime
  preferredTime     String?
  additionalNotes   String?
  totalPrice        Int
  originalPrice     Int?      // admin's original/list price snapshot per person at booking time
  basePrice         Int?      // our standard discounted selling price snapshot per person
  unitPrice         Int?      // actual per-person price charged (availability override or basePrice)
  couponId          String?
  discountAmount    Int        @default(0)
  status            String     @default("pending")
  paymentId         String?
  paymentOrderId    String?
  paymentStatus     String     @default("pending")
  paymentAmount     Int?
  paymentCompletedAt DateTime?
  negotiatedPrice   Int?
  priceLocked       Boolean    @default(false)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  coupon            Coupon?    @relation(fields: [couponId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model PackageWishlist {
  id        String   @id @default(cuid())
  userId    String
  packageId String
   user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
   package   Package  @relation(fields: [packageId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@unique([userId, packageId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
   user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   @default("info")
  read      Boolean  @default(false)
   link      String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([userId, read])
}

model PushSubscription {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint     String
  p256dh       String
  auth         String
  userAgent    String?
  createdAt    DateTime @default(now())

  @@unique([userId, endpoint])
}

model Payment {
  id           String          @id @default(cuid())
  userId       String
   user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookingId    String?
  pkgBookingId String?
  amount       Int
  method       String          @default("online")
  transactionId String?
  status       String          @default("completed")
  createdAt    DateTime        @default(now())
}

// A price offer exchanged during negotiation on a booking (admin <-> user)
model BookingOffer {
  id          String   @id @default(cuid())
  bookingType String   // "tour" | "package" | "destination"
  bookingId   String
    offeredBy   String   // "admin" | "user"
  amount      Int
  note        String?
  status      String   @default("pending") // pending | accepted | rejected | countered
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Payment request from admin to user for balance/due amount
model PaymentRequest {
  id            String   @id @default(cuid())
  bookingType   String   // "destination" | "package" | "tour" | "taxi"
  bookingId     String
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount        Int
  paidAmount    Int      @default(0)
  balanceAmount Int
  status        String   @default("pending") // pending | paid | cancelled
  message       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// A receipt for any payment made against a booking (advance, balance, or full).
// Covers online gateway payments, admin-recorded cash payments, and manual entries.
model PaymentReceipt {
  id          String   @id @default(cuid())
  userId      String
   user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookingType String   // "tour" | "package" | "destination"
  bookingId   String
  amount      Int
   method      String   @default("online") // online | cash | manual | gateway
  type        String   @default("balance") // advance | balance | full
  txnId       String?
  addedBy     String   @default("user") // user | admin
  note        String?
   status      String   @default("completed")
  createdAt   DateTime @default(now())
}

model SiteSetting {
  id    String @id @default(cuid())
  key   String @unique
  value String
}

model ContactInquiry {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  message   String
  subject   String?
  source    String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Coupon {
  id                 String           @id @default(cuid())
  code               String           @unique
  description        String?
  discountPct        Int
  maxDiscount        Int?
  minAmount          Int?
  maxUses            Int?              @default(0)
  usedCount          Int              @default(0)
  expiresAt          DateTime?
  active             Boolean          @default(true)
  type               String           @default("public") // "public" | "influencer" | "referral"
  isPrivate          Boolean          @default(false)    // true if hidden from user dashboard
  applicableCategory String?                             // e.g. "all", "rafting", "stay-camping", "trekking"
  userEligibility    String           @default("all")    // "all" | "new_users_only" | "existing_users"
  creatorName        String?                             // creator name if influencer code
  createdAt          DateTime         @default(now())
  bookings           PackageBooking[]
}

model Media {
  id        String   @id @default(cuid())
  url       String
  label     String?
  alt       String?
  category  String?
  createdAt DateTime @default(now())
}

model TourDestination {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  type      String   @default("day-based") // "day-based" or "single-select"
  config    String   @default("{}") // JSON: heroImage, heroTitle, heroSubtitle, heroTag, sectionTitle, sectionSubtitle
  programs  String   @default("[]") // JSON: array of {id, title, img, itinerary[]}
  dayConfigs String  @default("[]") // JSON: for day-based: [{label, title, maxSelect}]
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StayContent {
  id          String   @id @default(cuid())
  section     String   @unique // "hotel" or "camping"
  name        String
  description String
  tag         String?  // badge text like "Riverside Camping"
  rating      Float    @default(0)
  images      String   @default("[]") // JSON array of Google Drive file IDs
  features    String   @default("[]") // JSON array of feature/amenity names
  pricings    String   @default("[]") // JSON array of {label, sublabel, price, unit, highlighted}
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Company {
  id          String         @id @default(cuid())
  name        String
  slug        String         @unique
  logo        String?
  photo       String?
  description String?
  website     String?
  order       Int            @default(0)
  active      Boolean        @default(true)
  plans       CompanyPlan[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model CompanyPlan {
  id           String   @id @default(cuid())
  companyId    String
  name         String
  description  String?
  price        Int?
  image        String?
  category     String?  // e.g. "Bungee", "Water Sports", "Zipline", "Paragliding"
  duration     String?
  highlights   String?  // JSON array of highlights
  packageSlug  String?  // links to Package.slug for image/navigation
  active       Boolean  @default(true)
  order        Int      @default(0)
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model HeroNotice {
  id          String   @id @default(cuid())
  image       String?
  heading     String
  description String?
  link        String?  // URL to redirect when clicked
  active      Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model DateAvailability {
  id         String   @id @default(cuid())
  date       String   // start date "2026-06-05"
  dateTo     String?  // end date (null = single date)
  service    String   // "rafting", "trekking", "taxi", "bike", "stay", "tour-packages"
  subOptions String   @default("[]") // JSON array of available sub-options
  allDay     Boolean  @default(false) // if true, everything for this service is available
  price      Int?     // price per person/unit for this date range
  slots      Int?     // available slots/quantity
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([service, date], name: "service_date")
}

model TourBooking {
  id                String   @id @default(cuid())
  userId            String?  // nullable for non-logged-in users
  destination      String   // "Rishikesh", "Haridwar", etc.
  dayLabel         String?  // "Day 1", "Day 2", "Day 3", "Master", or null for single-select
  packageType      String   // "Rishikesh Day 1", "Hill Station Tour", etc.
  selectedPrograms String   // JSON array of selected program names
  itinerary        String?  // JSON: [{ day: number, programId: number, title: string }]
  days             Int?      // total number of days chosen by the user
  note             String?  // customer note added at inquiry time
  name             String
  phone            String
  travelDate       String
  travelers        Int      @default(1)
  status           String   @default("pending") // "pending", "confirmed", "rejected", "cancelled"
  adminNotes       String?
  paymentStatus    String   @default("pending")
  paymentId        String?
  paymentOrderId   String?
  paymentAmount    Int?
  paymentCompletedAt DateTime?
  negotiatedPrice  Int?
  priceLocked      Boolean  @default(false)
   totalPrice       Int?
  user             User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model BlogCategory {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  blogs       Blog[]
}

model Blog {
  id              String        @id @default(cuid())
  title           String
  slug            String        @unique
  content         String        // HTML content
  excerpt         String        // short description for archive cards
  featuredImage   String?
  tags            String        @default("[]") // JSON array of tag strings
  categoryId      String?
   category     BlogCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  author          String        @default("Divine Travels")
  published       Boolean       @default(false)
  publishedAt     DateTime?
  metaTitle       String?
  metaDescription String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model GalleryImage {
  id        String   @id @default(cuid())
  url       String
  title     String?
  alt       String?
   category  String?  // e.g. "Adventure", "Trekking", "Camping", "Sightseeing"
  featured  Boolean  @default(false) // show on homepage
  order     Int      @default(0)     // for sorting
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CreatorCollaboration {
  id                String   @id @default(cuid())
  name              String
  email             String
  phone             String
  instagram         String?
  youtube           String?
  followersCount    String   // e.g. "10K - 50K", "50K - 100K", "100K+"
  niche             String   // e.g. "Adventure & Rafting", "Trekking", "Luxury Stays", "Travel Vlogging", "Spiritual Tours"
  collaborationType String   // "barter", "affiliate", "paid"
  deliverables      String?  // e.g. "2 Reels + 1 YouTube Vlog"
  travelDates       String?  // e.g. "Next Month", "September 2026"
  message           String?  // Pitch / notes
  status            String   @default("pending") // "pending", "approved", "rejected", "completed"
  assignedCoupon    String?  // Custom creator promo code
  commissionPct     Int?     @default(10)
  adminNotes        String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Refund {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookingType   String   // "tour" | "package" | "destination"
  bookingId     String
  bookingTitle  String?
  totalAmount   Int
  amountPaid    Int
  refundAmount  Int
  refundPct     Int      // percentage applied (e.g. 90 for 90%)
  reason        String?
  cancelDate    DateTime @default(now())
  travelDate    DateTime?
  daysBefore    Int?     // days between cancel and travel
  status        String   @default("pending") // pending | paid | rejected
  paidAt        DateTime?
  paidMethod    String?  // upi | bank | cash
  adminNote     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}