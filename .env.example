# ===== Divine Travels — Environment Variables Template =====
# Copy this file to `.env` locally, or set these as Environment Variables in Vercel.
# NEVER commit the real `.env` (it contains secrets).

# --- Database (Turso libSQL) ---
DATABASE_URL="libsql://your-db.turso.io"
TURSO_AUTH_TOKEN="your-turso-auth-token"

# --- Auth (JWT) — set a long random string in production ---
JWT_SECRET="change-me-to-a-long-random-string"

# --- KwikPik Payment Gateway ---
KWIKUPI_API_KEY="your-kwikupi-api-key"
KWIKUPI_API_SECRET="your-kwikupi-api-secret"

# --- Public base URL (used for payment redirects, emails, reset links) ---
# Canonical production domain. Keep this as the custom domain, NOT the
# vercel.app alias (divine-travels.vercel.app is disabled on another account).
NEXT_PUBLIC_BASE_URL="https://divinetravels.in"

# --- SMTP (password reset / notification emails) ---
SMTP_HOST="mail.yourdomain.com"
SMTP_PORT="587"
SMTP_USER="connect@yourdomain.com"
SMTP_PASS="your-smtp-password"
SMTP_FROM="Divine Travels <connect@yourdomain.com>"
